# GitHub API token (read-only, public repos) used by scripts/build-knowledge.ts.
GITHUB_TOKEN=

# --- LLM providers (api/chat.ts + evals) ----------------------------------
# Set at least ONE key. The assistant tries every provider that has a key, in
# this order, and falls through to the next if one fails (bad key, no credit,
# rate limit, prompt too big for the tier):
#   gemini -> groq -> openrouter -> ollama
# Override the order with e.g. LLM_PROVIDERS=groq,gemini
#
# Google AI Studio (free tier, 1M context — best fit for the ~50K-token corpus)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# default gemini-flash-latest
GEMINI_MODEL=
# Groq (fast; free-tier tokens-per-minute limits may reject the full corpus)
GROQ_API_KEY=
# default openai/gpt-oss-120b
GROQ_MODEL=
# OpenRouter
OPENROUTER_API_KEY=
# default openai/gpt-oss-120b
OPENROUTER_MODEL=
# Ollama Cloud (now paid)
OLLAMA_API_KEY=
# default gpt-oss:120b
OLLAMA_MODEL=
LLM_PROVIDERS=

# Optional override for the knowledge-pipeline's context-window budget
# check (scripts/knowledge/tokenEstimate.ts). Defaults to 128000 if unset.
KNOWLEDGE_CONTEXT_WINDOW=

# --- evals (npm run eval) ------------------------------------------------
# Uses the same provider keys/order above for both the assistant and the judge.
# EVAL_TARGET_URL   point at a deployed assistant instead of starting Vite
# EVAL_JUDGE=0      skip the LLM judge (deterministic assertions only)
# EVAL_STRICT_JUDGE=1  make judge disagreements fail the run
# EVAL_CONCURRENCY  parallel cases (default 3)
