# GitHub API token (read-only, public repos) used by scripts/build-knowledge.ts.
GITHUB_TOKEN=

# Ollama Cloud API key, used by api/chat.ts. Create one at
# https://ollama.com/settings/keys
OLLAMA_API_KEY=

# Ollama Cloud model for api/chat.ts. Defaults to gpt-oss:120b if unset.
# See https://ollama.com/search?c=cloud for the current cloud model list.
OLLAMA_MODEL=

# Upstash Redis REST credentials for per-IP rate limiting and refusal logging
# in api/chat.ts. If unset, the endpoint still works but is NOT rate limited —
# production must set both. https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional override for the knowledge-pipeline's context-window budget
# check (scripts/knowledge/tokenEstimate.ts). Defaults to 128000 if unset.
# Revisit once Phase 2 locks in the exact Ollama Cloud model.
KNOWLEDGE_CONTEXT_WINDOW=

# --- evals (npm run eval) ------------------------------------------------
# Uses OLLAMA_API_KEY above for both the assistant and the judge.
# EVAL_TARGET_URL   point at a deployed assistant instead of starting Vite
# EVAL_JUDGE=0      skip the LLM judge (deterministic assertions only)
# EVAL_STRICT_JUDGE=1  make judge disagreements fail the run
# EVAL_JUDGE_MODEL  judge model override (defaults to OLLAMA_MODEL)
# EVAL_CONCURRENCY  parallel cases (default 3)
# DIGEST_DAYS       lookback window for `npm run eval:digest` (default 7)
